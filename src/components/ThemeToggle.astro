<button id="tema" class="btn tema-btn" type="button" aria-label="Cambiar a tema oscuro">
  <!-- Luna: visible en tema claro -->
  <svg class="icono-luna" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>

  <!-- Sol: visible en tema oscuro -->
  <svg class="icono-sol" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
</button>

<style>
  .tema-btn {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border-radius: 9999px;

    /* Visible solo en el tope de la página */
    opacity: 1;
    visibility: visible;
    transition: opacity .3s ease, visibility .3s;
  }

  /* Oculto al hacer scroll: visibility evita clics y foco con teclado mientras no se ve */
  .tema-btn.oculto {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tema-btn { transition: none; }
  }

  /* Tema claro: se ve la luna; tema oscuro: se ve el sol */
  .icono-sol { display: none; }
  :global(:root[data-theme="dark"]) .icono-sol { display: block; }
  :global(:root[data-theme="dark"]) .icono-luna { display: none; }
</style>

<script>
  const btn = document.getElementById('tema')!;
  const root = document.documentElement;

  const actualizarEtiqueta = () => {
    const oscuro = root.dataset.theme === 'dark';
    btn.setAttribute('aria-label', oscuro ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
  };

  actualizarEtiqueta();

  btn.addEventListener('click', () => {
    const nuevo = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nuevo;
    localStorage.setItem('tema', nuevo);
    actualizarEtiqueta();
  });

  // Mostrar solo en el tope de la página (con un pequeño margen de tolerancia)
  const UMBRAL = 10;
  const actualizarVisibilidad = () => {
    btn.classList.toggle('oculto', window.scrollY > UMBRAL);
  };

  window.addEventListener('scroll', actualizarVisibilidad, { passive: true });
  actualizarVisibilidad(); // por si la página carga ya con scroll (recarga a mitad de página)
</script>